# Session signing secret. Generate with: openssl rand -base64 32
AUTH_SECRET=

# Public origin, used to build OAuth redirect URIs.
APP_ORIGIN=http://localhost:3000

# Google OAuth (optional). Without these, "Continue with Google" is shown
# disabled with an honest explanation instead of a broken button.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email delivery (optional). Without it, verification codes are written to
# the server log so the flow is testable in development.
EMAIL_FROM="Piasowo <no-reply@piasowo.com>"
RESEND_API_KEY=

# AI scoring, research and drafting (optional). Without a key, Piasowo falls
# back to deterministic templates and says so in the UI.
# Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Any model OpenRouter fronts. Defaults to anthropic/claude-opus-5.
OPENROUTER_MODEL=

# Real prospect sourcing (optional). Without a key, the Sourced view explains
# that it isn't connected instead of showing invented companies.
# Settings -> Integrations -> API in Apollo; confirm your plan includes API access.
APOLLO_API_KEY=
