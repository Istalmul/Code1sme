# Session signing secret. Generate with: openssl rand -base64 32
AUTH_SECRET=

# Public origin. Usually leave this blank — Piasowo reads the address each
# request actually arrived on, so the Google redirect URI is correct on
# localhost, in a Codespace and behind a tunnel without any configuration.
# Set it only in production behind a proxy that doesn't forward the real host.
APP_ORIGIN=

# Google sign-in (optional). Visit /setup/google in the running app: it shows
# the exact redirect URI to register, taken from wherever you are running.
# Without these the Google button is switched off and links to that page,
# rather than failing when tapped.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Email delivery. Without one of these, verification codes are written to the
# server log so the flow stays testable — they are never shown in the browser.
# ---------------------------------------------------------------------------
EMAIL_FROM="Piasowo <no-reply@piasowo.com>"

# Option A — SMTP. Works with a Gmail app password (Google Account -> Security
# -> 2-Step Verification -> App passwords; your normal password will not work).
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USER=you@gmail.com
#   SMTP_PASSWORD=the-16-character-app-password
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Option B — Resend. https://resend.com
RESEND_API_KEY=

# ---------------------------------------------------------------------------
# SMS and WhatsApp verification (optional). Used to prove a phone number
# belongs to the user before anything can be sent from it.
# Credentials: https://console.twilio.com
# ---------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# A Twilio number you own, in +E.164 format.
TWILIO_SMS_FROM=
# The WhatsApp sender. The sandbox number is +14155238886 — join it from your
# phone first, or use your own approved sender.
TWILIO_WHATSAPP_FROM=

# AI scoring, research and drafting (optional). Without a key, Piasowo falls
# back to deterministic templates and says so in the UI.
# Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Any model OpenRouter fronts. Defaults to anthropic/claude-opus-5.
OPENROUTER_MODEL=

# Real prospect sourcing (optional). Without a key, the Sourced view explains
# that it isn't connected instead of showing invented companies.
# Settings -> Integrations -> API in Apollo; confirm your plan includes API access.
APOLLO_API_KEY=
