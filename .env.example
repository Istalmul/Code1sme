# Session signing secret. Generate with: openssl rand -base64 32
AUTH_SECRET=

# Public origin, used to build OAuth redirect URIs.
APP_ORIGIN=http://localhost:3000

# Google OAuth (optional). Without these, "Continue with Google" is shown
# disabled with an honest explanation instead of a broken button.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email delivery (optional). Without it, verification codes are written to
# the server log so the flow is testable in development.
EMAIL_FROM="Piasowo <no-reply@piasowo.com>"
RESEND_API_KEY=
